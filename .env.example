# PORT & APP_URL: Runtime server port and hosted application URL.
PORT="3000"
APP_URL="http://localhost:3000"

# PostgreSQL Connection (configured via Unix socket or TCP host)
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="facicuse"
SQL_USER="facicuse_app"
SQL_PASSWORD="CHANGE_ME"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="CHANGE_ME"
# Set to "true" for hosted providers requiring SSL (e.g. Neon). Auto-enabled for neon hosts.
SQL_SSL="false"

# Comma-separated official university email domains allowed for new registrations.
# Defaults to BatStateU domains when left unset.
ALLOWED_UNIVERSITY_DOMAINS="g.batstate-u.edu.ph"

# Comma-separated institutional email addresses provisioned with System Administrator access upon sign-in.
# Configure with authorized university administrator addresses before production launch.
ADMIN_BOOTSTRAP_EMAILS="24-03337@g.batstate-u.edu.ph"

# Server-side HMAC secret for signed session cookies (required in production).
# Generate a 32+ byte random string in production.
SESSION_SECRET="CHANGE_ME_GENERATE_32_BYTE_SECRET"
