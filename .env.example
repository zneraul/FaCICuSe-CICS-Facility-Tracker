# Local development defaults. Configure production values in Render's Environment settings.
PORT="3000"
APP_URL="http://localhost:3000"

# PostgreSQL connection. DATABASE_URL is preferred for hosted Neon deployments.
# Alternatively configure the SQL_* variables below.
DATABASE_URL=""
# Optional elevated URL used only by Drizzle migrations; keep DATABASE_URL for app runtime.
MIGRATION_DATABASE_URL=""
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="facicuse"
SQL_USER="facicuse_app"
SQL_PASSWORD="CHANGE_ME"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="CHANGE_ME"
SQL_SSL="false"

# Comma-separated official university email domains allowed for registration.
ALLOWED_UNIVERSITY_DOMAINS="g.batstate-u.edu.ph"

# Optional comma-separated administrator accounts. Keep actual addresses in Render,
# never commit production account details here.
ADMIN_BOOTSTRAP_EMAILS=""

# Required in production; generate a random secret of at least 32 characters.
SESSION_SECRET="CHANGE_ME_GENERATE_32_BYTE_SECRET"
